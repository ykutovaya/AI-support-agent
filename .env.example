# Не сохраняйте настоящие ключи в Git.
# Настройки модели читаются только при SUPPORT_AGENT_MODE=api в окружении процесса.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Настройки Zammad читаются только при SUPPORT_AGENT_TICKET_BACKEND=zammad
# в окружении процесса. Это не включает API модели: SUPPORT_AGENT_MODE=demo сохраняется.
# Окружение имеет приоритет над .env. ID и имя группы должны совпадать с экземпляром.
ZAMMAD_URL=https://your-instance.zammad.com
ZAMMAD_TOKEN=
ZAMMAD_GROUP_ID=2
ZAMMAD_GROUP_NAME="Retail Demo"
# Явное соответствие синтетического клиента retail существующему клиенту Zammad.
ZAMMAD_CUSTOMER_MAP='{"u1":4}'
